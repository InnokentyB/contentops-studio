generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["planner"]
}

// ============================================
// Authentication & Users
// ============================================

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  memberships      ProjectMember[]
  sent_invitations ProjectInvitation[]

  @@map("users")
  @@schema("planner")
}

// ============================================
// Projects & Teams
// ============================================

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  kind        String    @default("content_network")
  is_archived Boolean   @default(false)
  archived_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  members     ProjectMember[]
  channels    SocialChannel[]
  weeks       Week[]
  posts       Post[]
  settings    ProjectSettings[]
  invitations ProjectInvitation[]
  runs        AgentRun[]

  // v2 Media Orchestrator Relations
  quarter_plans           QuarterPlan[]
  month_arcs              MonthArc[]
  week_packages           WeekPackage[]
  content_items           ContentItem[]
  feedbacks               FeedbackPackage[]
  work_items              WorkItem[]
  workflow_events         WorkflowEvent[]
  initiatives             Initiative[]
  initiative_dependencies InitiativeDependency[]
  vk_metric_snapshots     VkMetricSnapshot[]
  outbox_events           OutboxEvent[]
  webhook_inbox           WebhookInbox[]
  delivery_attempts       DeliveryAttempt[]



  prompt_presets    PromptPreset[]
  comments          Comment[]
  provider_keys     ProviderKey[]
  telegram_accounts TelegramAccount[]

  @@index([is_archived])
  @@index([kind])
  @@map("projects")
  @@schema("planner")
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  project_id Int
  user_id    Int
  role       String // "owner", "editor", "viewer"
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@map("project_members")
  @@schema("planner")
}

model ProjectInvitation {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  email      String?
  project_id Int
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  role       String   @default("viewer") // viewer, editor, owner
  created_at DateTime @default(now())
  expires_at DateTime
  created_by Int? // Make created_by optional for now, will be added back if needed

  creator User? @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([token])
  @@map("project_invitations")
  @@schema("planner")
}

model ProjectSettings {
  id         Int      @id @default(autoincrement())
  project_id Int
  key        String
  value      String
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, key])
  @@map("project_settings")
  @@schema("planner")
}

// ============================================
// Social Media Channels
// ============================================

model SocialChannel {
  id         Int      @id @default(autoincrement())
  project_id Int
  type       String // "telegram", "vk", "instagram", "twitter", "linkedin"
  name       String
  config     Json // Platform-specific configuration
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project             Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  posts               Post[]
  content_items       ContentItem[]
  vk_metric_snapshots VkMetricSnapshot[]

  @@map("social_channels")
  @@schema("planner")
}

// ============================================
// Content Planning
// ============================================

model Week {
  id            Int      @id @default(autoincrement())
  project_id    Int
  week_start    DateTime @db.Date
  week_end      DateTime @db.Date
  theme         String
  status        String
  regen_attempt Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project     Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  posts       Post[]
  week_memory WeekMemory?

  @@unique([project_id, week_start, week_end])
  @@map("weeks")
  @@schema("planner")
}

model Post {
  id                  Int      @id @default(autoincrement())
  project_id          Int
  week_id             Int
  channel_id          Int? // Which social channel to publish to
  slot_date           DateTime @db.Date
  slot_index          Int
  publish_at          DateTime @db.Timestamptz(6)
  topic_index         Int
  topic               String?
  category            String?
  tags                String[] @default([])
  image_url           String?
  image_prompt        String?
  generated_text      String?
  final_text          String?
  status              String
  approval_message_id BigInt?
  telegram_message_id Int?
  published_link      String?

  // Sequential Generation Fields
  core_takeaway String?
  key_points    Json? // Array of strings
  tool_used     String?
  angle         String?
  critic_score  Int?

  metrics Json? // Stores views, likes, comments, etc.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  week    Week           @relation(fields: [week_id], references: [id], onDelete: Cascade)
  channel SocialChannel? @relation(fields: [channel_id], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([week_id])
  @@index([publish_at])
  @@index([status])
  @@map("posts")
  @@schema("planner")
}

model WeekMemory {
  id                Int      @id @default(autoincrement())
  week_id           Int      @unique
  week              Week     @relation(fields: [week_id], references: [id], onDelete: Cascade)
  week_core_summary String // Aggregated summary
  covered_angles    Json // Array of strings
  used_tools        Json // Array of strings
  banned_takeaways  Json // Array of strings
  updated_at        DateTime @updatedAt

  @@map("week_memories")
  @@schema("planner")
}

// ============================================
// System & Logging
// ============================================

model Event {
  id          Int      @id @default(autoincrement())
  ts          DateTime @default(now()) @db.Timestamptz(6)
  entity_type String
  entity_id   Int
  event_type  String
  payload     Json?

  @@map("events")
  @@schema("planner")
}

model AgentRun {
  id         Int      @id @default(autoincrement())
  project_id Int
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  type       String // 'week_plan', 'post_write', 'image_gen', 'image_chain', etc.
  agent_role String? // 'visual_architect', 'post_creator', 'critic', etc.
  status     String // 'success', 'failed'
  input      String?
  prompt     String?
  output     String?
  error      String?
  created_at DateTime @default(now())

  // Legacy fields (optional to match old schema if needed, or removed)
  // topic            String // Removed/Mapped to input
  final_score      Int @default(0)
  total_iterations Int @default(0)

  iterations AgentIteration[] // Relation 

  @@index([project_id])
  @@index([type])
  @@map("agent_runs")
  @@schema("planner")
}

// Keeping AgentIteration for now but might be unused if we log everything in AgentRun or separate table
model AgentIteration {
  id               Int      @id @default(autoincrement())
  run_id           Int
  iteration_number Int
  agent_role       String
  input            String
  output           String
  score            Int?
  critique         String?
  created_at       DateTime @default(now())

  run AgentRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id])
  @@map("agent_iterations")
  @@schema("planner")
}

// ============================================
// Legacy (to be migrated)
// ============================================

// This will be removed after migration to ProjectSettings
model PromptSettings {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@map("prompt_settings")
  @@schema("planner")
}

// ============================================
// Feedback & Customization
// ============================================

model PromptPreset {
  id          Int      @id @default(autoincrement())
  project_id  Int
  role        String // "post_creator", "topic_creator", etc.
  name        String
  prompt_text String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("prompt_presets")
  @@schema("planner")
}

model Comment {
  id          Int      @id @default(autoincrement())
  project_id  Int
  entity_type String // "week", "post"
  entity_id   Int
  text        String
  author_role String // "user", "assistant" (or specific agent role)
  created_at  DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, entity_type, entity_id])
  @@map("comments")
  @@schema("planner")
}

model ProviderKey {
  id         Int      @id @default(autoincrement())
  project_id Int
  name       String
  key        String
  provider   String // "OpenAI", "Anthropic", "Gemini", "Other"
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("provider_keys")
  @@schema("planner")
}

model TelegramAccount {
  id             Int      @id @default(autoincrement())
  project_id     Int
  project        Project  @relation(fields: [project_id], references: [id])
  phone_number   String
  session_string String   @db.Text
  api_id         Int
  api_hash       String
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([project_id, phone_number])
  @@map("telegram_accounts")
  @@schema("planner")
}

// ============================================
// v2 Media Orchestrator Models
// ============================================

model QuarterPlan {
  id                 Int      @id @default(autoincrement())
  project_id         Int
  quarter_start      DateTime @db.Date
  quarter_end        DateTime @db.Date
  strategic_goal     String? // Awareness/Authority/Conversion mix
  primary_pillar     String?
  monetization_focus String? // none / mini-products / intensive / flagship / club
  planned_channels   Json? // e.g. { "123": "onboarding", "456": "sales" }
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  month_arcs MonthArc[]

  @@map("quarter_plans")
  @@schema("planner")
}

model MonthArc {
  id                Int      @id @default(autoincrement())
  project_id        Int
  quarter_plan_id   Int?
  month             DateTime @db.Date // Representing the month
  arc_theme         String?
  arc_thesis        String?
  key_concepts      Json? // Array of strings
  planned_longreads Json? // Habr/VC/Zen plan
  planned_video     Json? // Video scripts count/plan
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  quarter_plan  QuarterPlan?  @relation(fields: [quarter_plan_id], references: [id], onDelete: SetNull)
  week_packages WeekPackage[]

  @@map("month_arcs")
  @@schema("planner")
}

model WeekPackage {
  id               Int      @id @default(autoincrement())
  project_id       Int
  month_arc_id     Int?
  week_start       DateTime @db.Date
  week_end         DateTime @db.Date
  week_theme       String?
  core_thesis      String?
  audience_focus   String? // Beginner/Developing/Expert mix
  intent_tag       String? // Awareness/Authority/Warmup/Launch/Maintenance
  monetization_tie String? // none / hint / launch etc.
  narrative_arc    Json? // day1->day7 logic
  cross_links      Json? // cross link planning
  risks            Json? // oversimplify, too_deep, repetition
  channel_mix      Json? // Channel quota selected by MTA (e.g. { tg_post: 3, habr: 1 })
  plan_id          String?
  plan_version     String?
  timezone         String?  @default("UTC")
  approval_status  String   @default("draft") // draft/needs_review/approved/rejected
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  project         Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  month_arc       MonthArc?       @relation(fields: [month_arc_id], references: [id], onDelete: SetNull)
  content_items   ContentItem[]
  work_items      WorkItem[]
  workflow_events WorkflowEvent[]
  initiatives     Initiative[]

  @@map("week_packages")
  @@schema("planner")
}

model ContentItem {
  id                  Int       @id @default(autoincrement())
  project_id          Int
  week_package_id     Int?
  channel_id          Int? // Target channel
  type                String // tg_post, vk_post, habr_article, vc_article, zen_article, video_script
  layer               String? // azbuka, analyst, pro, community
  title               String?
  brief               String?
  key_points          Json? // Array of strings
  cta                 String?
  cross_link_to       Json? // Array of target IDs
  assets              Json? // Images or diagrams
  draft_text          String?
  status              String    @default("planned") // planned, drafted, revised, approved, scheduled, published, failed
  schedule_at         DateTime? @db.Timestamptz(6)
  quality_report      Json?
  metrics             Json?
  telegram_message_id Int? // Fallback UI tracking
  published_link      String?
  item_key            String?
  content_due_at      DateTime? @db.Timestamptz(6)
  publish_at          DateTime? @db.Timestamptz(6)
  review_policy       String?
  publication_mode    String?   @default("manual_handoff")
  source_refs         Json?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  project             Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  week_package        WeekPackage?       @relation(fields: [week_package_id], references: [id], onDelete: SetNull)
  channel             SocialChannel?     @relation(fields: [channel_id], references: [id], onDelete: SetNull)
  work_items          WorkItem[]
  workflow_events     WorkflowEvent[]
  vk_metric_snapshots VkMetricSnapshot[]

  @@index([project_id])
  @@index([week_package_id])
  @@index([status])
  @@map("content_items")
  @@schema("planner")
}

model VkMetricSnapshot {
  id                     Int      @id @default(autoincrement())
  project_id             Int
  channel_id             Int
  content_item_id        Int
  owner_id               String
  post_id                String
  logical_date           DateTime @db.Date
  collection_mode        String   @default("automatic")
  captured_at            DateTime @default(now()) @db.Timestamptz(6)
  wall_status            String
  reach_status           String
  views                  Int?
  likes                  Int?
  comments               Int?
  reposts                Int?
  reach_total            Int?
  reach_subscribers      Int?
  reach_viral            Int?
  reach_ads              Int?
  link_clicks            Int?
  group_clicks           Int?
  group_joins            Int?
  hides                  Int?
  reports                Int?
  unsubscribes           Int?
  provider_error_code    String?
  provider_error_message String?
  raw_payload            Json?
  created_at             DateTime @default(now())

  project      Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  channel      SocialChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  content_item ContentItem   @relation(fields: [content_item_id], references: [id], onDelete: Cascade)

  @@unique([content_item_id, logical_date, collection_mode])
  @@index([project_id, logical_date])
  @@index([channel_id, logical_date])
  @@index([owner_id, post_id])
  @@map("vk_metric_snapshots")
  @@schema("planner")
}

model FeedbackPackage {
  id                  Int      @id @default(autoincrement())
  project_id          Int
  period              String // 'week' or 'month'
  period_start        DateTime @db.Date
  period_end          DateTime @db.Date
  per_channel_metrics Json?
  owner_scores        Json? // accuracy, style, depth, usefulness
  notes               String?
  recommendations     String?
  applied_changes     String?
  created_at          DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("feedback_packages")
  @@schema("planner")
}

model WorkItem {
  id                    Int       @id @default(autoincrement())
  project_id            Int
  week_package_id       Int?
  content_item_id       Int?
  item_key              String
  kind                  String // plan_review, content_write, content_review
  state                 String // pending, available, claimed, waiting_approval, blocked, completed, cancelled
  assignee_role         String // plan_reviewer, content_writer, content_reviewer
  depends_on_item_id    Int?
  due_at                DateTime? @db.Timestamptz(6)
  lease_token           String?
  lease_expires_at      DateTime? @db.Timestamptz(6)
  lease_actor_id        String?
  input_context_version Int       @default(1)
  result_version        Int       @default(0)
  result_payload        Json?
  reason_code           String?
  note                  String?
  missing_resource_refs Json?
  tracker_provider      String?
  tracker_project_id    String?
  tracker_item_id       String?
  tracker_url           String?
  sync_version          Int       @default(1)
  last_synced_at        DateTime? @db.Timestamptz(6)
  sync_status           String?
  sync_error            String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt


  project            Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  week_package       WeekPackage?       @relation(fields: [week_package_id], references: [id], onDelete: SetNull)
  content_item       ContentItem?       @relation(fields: [content_item_id], references: [id], onDelete: SetNull)
  initiative         Initiative?        @relation(fields: [initiative_id], references: [id], onDelete: SetNull)
  initiative_id      Int?
  approval_decisions ApprovalDecision[]
  workflow_events    WorkflowEvent[]
  outbox_events      OutboxEvent[]


  @@index([project_id])
  @@index([week_package_id])
  @@index([content_item_id])
  @@index([initiative_id])
  @@index([state])
  @@index([kind])
  @@index([due_at])
  @@map("work_items")
  @@schema("planner")
}

model Initiative {
  id                  Int       @id @default(autoincrement())
  project_id          Int
  campaign_id         Int?
  week_package_id     Int?
  external_key        String
  kind                String // publication, event, campaign, infrastructure
  subtype             String? // post, email_sequence, robots_change, seeding_wave, lesson, cfp, decision_gate
  title               String
  description         String?
  status              String    @default("planned") // planned, in_progress, completed, blocked, cancelled
  owner_role          String?
  due_at              DateTime? @db.Timestamptz(6)
  start_at            DateTime? @db.Timestamptz(6)
  end_at              DateTime? @db.Timestamptz(6)
  decision_at         DateTime? @db.Timestamptz(6)
  event_at            DateTime? @db.Timestamptz(6)
  measurement_at      DateTime? @db.Timestamptz(6)
  dependencies_status String    @default("dependencies_unknown") // dependencies_unknown, confirmed, none
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  project               Project                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  week_package          WeekPackage?           @relation(fields: [week_package_id], references: [id], onDelete: SetNull)
  work_items            WorkItem[]
  dependencies_outgoing InitiativeDependency[] @relation("FromInitiative")
  dependencies_incoming InitiativeDependency[] @relation("ToInitiative")

  @@unique([project_id, external_key])
  @@index([project_id])
  @@index([kind])
  @@index([status])
  @@map("initiatives")
  @@schema("planner")
}

model InitiativeDependency {
  id                 Int      @id @default(autoincrement())
  project_id         Int
  from_initiative_id Int
  to_initiative_id   Int
  type               String   @default("blocks") // blocks, requires, not_before, informs
  condition          String?
  source             String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  project         Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  from_initiative Initiative @relation("FromInitiative", fields: [from_initiative_id], references: [id], onDelete: Cascade)
  to_initiative   Initiative @relation("ToInitiative", fields: [to_initiative_id], references: [id], onDelete: Cascade)

  @@unique([from_initiative_id, to_initiative_id, type])
  @@index([project_id])
  @@index([from_initiative_id])
  @@index([to_initiative_id])
  @@map("initiative_dependencies")
  @@schema("planner")
}

model ApprovalDecision {
  id              Int      @id @default(autoincrement())
  work_item_id    Int
  result_version  Int
  decision        String // approved, rejected
  actor_id        String
  comment         String?
  idempotency_key String?
  created_at      DateTime @default(now())

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)

  @@unique([work_item_id, result_version])
  @@unique([work_item_id, actor_id, idempotency_key])
  @@index([work_item_id])
  @@index([idempotency_key])
  @@map("approval_decisions")
  @@schema("planner")
}

model WorkflowEvent {
  id              Int      @id @default(autoincrement())
  project_id      Int
  work_item_id    Int?
  week_package_id Int?
  content_item_id Int?
  actor_id        String
  command         String
  before_state    Json?
  after_state     Json?
  idempotency_key String?
  created_at      DateTime @default(now())

  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_item    WorkItem?    @relation(fields: [work_item_id], references: [id], onDelete: SetNull)
  week_package WeekPackage? @relation(fields: [week_package_id], references: [id], onDelete: SetNull)
  content_item ContentItem? @relation(fields: [content_item_id], references: [id], onDelete: SetNull)

  @@unique([project_id, actor_id, command, idempotency_key])
  @@index([project_id])
  @@index([work_item_id])
  @@index([idempotency_key])
  @@map("workflow_events")
  @@schema("planner")
}

model OutboxEvent {
  id              Int      @id @default(autoincrement())
  project_id      Int
  work_item_id    Int?
  event_type      String
  payload         Json
  sync_version    Int      @default(1)
  idempotency_key String?
  status          String   @default("pending") // pending, delivered, failed
  retry_count     Int      @default(0)
  last_error      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  project   Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_item WorkItem? @relation(fields: [work_item_id], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([status])
  @@index([idempotency_key])
  @@map("outbox_events")
  @@schema("planner")
}

model WebhookInbox {
  id         Int      @id @default(autoincrement())
  project_id Int
  event_id   String   @unique
  event_type String
  payload    Json
  status     String   @default("processed") // processed, duplicate, ignored
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([event_id])
  @@map("webhook_inbox")
  @@schema("planner")
}

model DeliveryAttempt {
  id                            Int       @id @default(autoincrement())
  project_id                    Int
  content_item_id               Int
  channel_id                    Int
  mode                          String    @default("assisted") // assisted, automatic
  status                        String    // pending, delivered, failed, recovered
  attempt_number                Int       @default(1)
  idempotency_key               String?
  scheduled_at                  DateTime? @db.Timestamptz(6)
  actual_published_at           DateTime? @db.Timestamptz(6)
  requires_manual_confirmation Boolean   @default(false)
  error_message                 String?
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([content_item_id])
  @@index([channel_id])
  @@index([idempotency_key])
  @@map("delivery_attempts")
  @@schema("planner")
}


