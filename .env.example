# Environment Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/ba_post_planner?schema=public"
TELEGRAM_BOT_TOKEN="your_bot_token"
OPENAI_API_KEY="your_openai_api_key"
STRONG_TEXT_MODEL="gpt-4o"
LOW_COST_TEXT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-2"
GOOGLE_API_KEY="your_google_ai_api_key"
# Optional override; retired Imagen model names are ignored safely.
GOOGLE_IMAGE_MODEL="gemini-3.1-flash-image"
OWNER_CHAT_ID=123456789

# Encrypts authenticated browser sessions stored in channel configuration.
# Generate a strong, unique value and keep it stable across deployments.
CHANNEL_SECRETS_KEY="replace-with-at-least-32-random-characters"

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# VK ID OAuth 2.1 (App ID is public; tokens remain encrypted in channel config)
VK_CLIENT_ID="your_vk_app_id"
VK_REDIRECT_URI="https://your-domain.example/api/integrations/vk/callback"
FRONTEND_URL="https://your-domain.example"

# LOCAL DEV ONLY: redirect all Telegram publishes to a test channel
LOCAL_TEST_CHANNEL=@test_cont_fabr

# BullMQ / Redis
REDIS_URL=redis://localhost:6379

# UAT / read-only local startup: disables Telegram/storage startup, schedulers,
# automatic publication, metrics collection, and queue workers.
BACKGROUND_JOBS_ENABLED=true
QUEUE_WORKERS_ENABLED=true
