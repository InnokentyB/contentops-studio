# Environment Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/contentops_studio?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
TELEGRAM_BOT_TOKEN="your_bot_token"
OPENAI_API_KEY="your_openai_api_key"
STRONG_TEXT_MODEL="gpt-4o"
LOW_COST_TEXT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-2"
GOOGLE_API_KEY="your_google_ai_api_key"
# Optional override; retired Imagen model names are ignored safely.
GOOGLE_IMAGE_MODEL="gemini-3.1-flash-image"
OWNER_CHAT_ID=123456789

# Encrypts authenticated browser sessions stored in channel configuration.
# Generate a strong, unique value and keep it stable across deployments.
CHANNEL_SECRETS_KEY="replace-with-at-least-32-random-characters"

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# VK ID OAuth 2.1 (App ID is public; tokens remain encrypted in channel config)
VK_CLIENT_ID="your_vk_app_id"
VK_REDIRECT_URI="https://your-domain.example/api/integrations/vk/callback"
FRONTEND_URL="https://your-domain.example"

# LOCAL DEV ONLY: redirect all Telegram publishes to a test channel
LOCAL_TEST_CHANNEL=@test_cont_fabr

# BullMQ / Redis
REDIS_URL=redis://localhost:6379

# UAT / read-only local startup: disables Telegram/storage startup, schedulers,
# automatic publication, metrics collection, and queue workers.
BACKGROUND_JOBS_ENABLED=true
QUEUE_WORKERS_ENABLED=true

# Optional Cloudflare R2 media storage. When all required values are present,
# R2 becomes the primary storage provider for generated and uploaded assets.
# Keep disabled until every R2 value below is configured and verified.
R2_ENABLED="false"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="planner-media"
R2_PUBLIC_BASE_URL="https://media.example.com"
# Set to "eu" only when the bucket was created in the EU jurisdiction.
R2_JURISDICTION="default"
# Optional explicit S3 endpoint override.
# R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# Secret key required to trigger internal scheduler job endpoints (/jobs/*)
INTERNAL_JOB_SECRET="set-a-secure-random-secret-for-internal-jobs"

# Optional development bypass for internal jobs (DO NOT USE IN PRODUCTION)
# ALLOW_INSECURE_JOBS="false"

# Verbose logging and runtime options
REQUEST_LOGGING_ENABLED="false"
ENABLE_INLINE_PUBLICATION_SCHEDULER="false"

# Anthropic Claude API (Supported via AI Gateway)
ANTHROPIC_API_KEY="your_anthropic_api_key"

# Public application URLs
PUBLIC_APP_URL="https://your-domain.example"
APP_URL="https://your-domain.example"

# Model Context Protocol (MCP) Remote Server Configuration
MCP_PORT=3004
MCP_HOST="0.0.0.0"
MCP_AUTH_TOKEN="your_mcp_auth_token"
MCP_REMOTE_URL="https://planner-mcp-production.up.railway.app"

# Research & Parser API Integration
PARSER_API_BASE_URL="https://parser-api-production.up.railway.app"
PARSER_SERVICE_TOKEN="your_parser_service_token"
PARSER_REQUEST_TIMEOUT_MS=15000

# Optional Database Schema & Host Aliases (Supabase / Railway compatibility)
# APP_DB_SCHEMA="planner"
# PLANNER_DB_SCHEMA="planner"
# APP_TARGET_DB_SCHEMA="planner"
# PLANNER_TARGET_SCHEMA="planner"
# DB_SSL_VERIFY="false"
# APP_DATABASE_URL="postgresql://user:password@host:5432/database"
# SUPABASE_DATABASE_URL="postgresql://user:password@host:5432/database"
# SUPABASE_DB_URL="postgresql://user:password@host:5432/database"
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database"
# APP_DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database"

# Optional MCP Integration Settings
# MCP_PRINCIPAL_USER_ID=""
# MCP_PROJECT_ID=""
# MCP_ORGANIZATION_RESEARCHER_AUTH_TOKEN=""
# MCP_ORGANIZATION_RESEARCHER_USER_ID=""
# MCP_ORGANIZATION_RESEARCHER_ORGANIZATION_ID=""
# MCP_JSON_BODY_LIMIT="10mb"

# Optional Platform & Cloud Providers (Railway / Redis / Google / LinkedIn / Reddit / Tilda / Supabase)
# REDISHOST="127.0.0.1"
# REDISPORT="6379"
# REDISPASSWORD=""
# REDISUSER=""
# ALLOW_ALL_ORIGINS="false"
# API_URL="http://localhost:3000"
# PUBLIC_URL="http://localhost:3000"
# DOMAIN="localhost"
# LINKEDIN_API_VERSION="202401"
# GSC_ACCESS_TOKEN=""
# GOOGLE_OAUTH_ACCESS_TOKEN=""
# GSC_SITE_URL=""
# SUPABASE_URL=""
# SUPABASE_KEY=""

# Reddit Publisher Integration
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_USERNAME=""
# REDDIT_PASSWORD=""
# REDDIT_USER_AGENT="planner/1.0"

# Tilda Publisher Integration
# TILDA_API_BASE="https://api.tildacdn.info/v1"
# TILDA_PUBLIC_KEY=""
# TILDA_SECRET_KEY=""
# TILDA_PROJECT_ID=""

# Parser DB Schema Settings
# PARSER_DB_SCHEMA="parser"
# PARSER_TARGET_SCHEMA="parser"

# Performance & Diagnostics
# PUBLICATION_RULES_CACHE_TTL_MS="300000"
# EGRESS_DIAGNOSTICS_ENABLED="false"

# Test Adapter Overrides
# ORGANIZATION_RESEARCH_ADAPTER_MODE="real"
# ORGANIZATION_RESEARCH_TEST_RESPONSE=""
# WEEK_TOPIC_GENERATOR_MODE="real"
# WEEK_TOPIC_GENERATOR_TEST_RESPONSE=""
