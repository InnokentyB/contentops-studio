{
  "name": "contentops-studio",
  "version": "1.0.0",
  "description": "A governed multi-channel content operations workspace with MCP access, research intake, approvals, publishing handoffs, and outcome analytics.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "npm install --prefix frontend && npm run build --prefix frontend && npx prisma generate && tsc",
    "build:backend": "npx prisma generate && tsc",
    "mcp:dev": "ts-node src/mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:remote:dev": "ts-node src/mcp/remote-server.ts",
    "mcp:remote:start": "node dist/mcp/remote-server.js",
    "telegram:setup": "ts-node scripts/setup_telegram_auth.ts",
    "telegram:encrypt-existing": "ts-node scripts/encrypt_telegram_accounts.ts",
    "scheduler:publication": "node dist/publication-scheduler.js",
    "test:mcp": "npm run build:backend >/dev/null && node scripts/test_mcp_server.js",
    "test:mcp:remote": "npm run build:backend >/dev/null && node scripts/test_remote_mcp.js",
    "test:tdpd:red": "npm run build:backend >/dev/null && node --env-file-if-exists=.env scripts/run_tdpd_red_tests.js",
    "test:tdpd:db": "npm run build:backend >/dev/null && TDPD_REQUIRE_DATABASE=1 node --env-file-if-exists=.env scripts/run_tdpd_red_tests.js",
    "test:mcp:plan": "npm run build:backend >/dev/null && node scripts/test_mcp_server.js",
    "test:parser": "npm run build:backend >/dev/null && node scripts/test_parser_chain.js",
    "demo:seed": "ts-node scripts/seed_product_demo.ts",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "migrate": "npx prisma migrate dev",
    "migrate:status": "npx prisma migrate status",
    "migrate:deploy": "npx prisma migrate deploy",
    "audit:tdpd:004-005": "node scripts/audit_tdpd_004_005_migration.js",
    "test": "npm run build >/dev/null && node --test dist/tests/**/*.test.js",
    "pilot:provision": "ts-node scripts/provision_pilot_user.ts"
  },
  "keywords": [
    "content-operations",
    "mcp",
    "publishing",
    "workflow",
    "analytics"
  ],
  "author": "Innokenty Bodrov",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/bcrypt": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "input": "^1.0.1",
    "ioredis": "^5.10.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "puppeteer": "^25.3.0",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "vk-io": "^4.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/puppeteer": "^5.4.7",
    "nodemon": "^3.1.11",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
